# Public browser configuration ONLY. Copy to .env.local (gitignored).
VITE_BASE_PATH=/huolto/
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT is also supported through VITE_SUPABASE_ANON_KEY.
# NEVER use sb_secret_*, a service_role JWT, database password or SMTP password here.
# Edge-only secrets are configured in Supabase Dashboard, never in VITE_* variables:
# APP_ORIGIN=https://585.fi
